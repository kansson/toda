{
  "name": "toda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "backend:deploy": "pnpm --filter @toda/backend run deploy",
    "backend:keys": "pnpm --filter @toda/backend run keys",
    "check": "vp check --fix && pnpm run typecheck && vp test run --coverage",
    "convex:dev": "pnpm --filter @toda/backend run dev",
    "dev:mobile": "pnpm --filter @toda/mobile run start",
    "i18n:extract": "pnpm --filter @toda/mobile run i18n:extract",
    "lint": "vp lint --fix",
    "mobile:android": "pnpm --filter @toda/mobile run android",
    "mobile:android:release": "pnpm --filter @toda/mobile run android:release",
    "mobile:export": "pnpm --filter @toda/mobile run export",
    "mobile:generate": "pnpm --filter @toda/mobile run generate",
    "mobile:icons": "pnpm --filter @toda/mobile run icons:generate",
    "mobile:licenses": "pnpm --filter @toda/mobile run licenses:generate",
    "prepare": "vp config",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.8.1"
  },
  "packageManager": "pnpm@12.4.1"
}
