{
  "name": "@toda/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "android": "lingui compile --strict && APP_VARIANT=development expo run:android",
    "android:release": "lingui compile --strict && APP_VARIANT=production expo run:android --variant release",
    "export": "lingui compile --strict && expo export --platform android",
    "generate": "lingui compile --strict && expo prebuild --platform android",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "icons:generate": "node scripts/generate-icons.ts",
    "licenses:generate": "node scripts/generate-licenses.ts",
    "start": "lingui compile --strict && expo start --dev-client",
    "typecheck": "lingui compile --strict && tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/auth": "catalog:",
    "@expo/material-symbols": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@expo/ui": "catalog:",
    "@formatjs/intl-getcanonicallocales": "catalog:",
    "@formatjs/intl-locale": "catalog:",
    "@formatjs/intl-pluralrules": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@react-native-community/netinfo": "catalog:",
    "@tanstack/convex-db-collection": "catalog:",
    "@tanstack/db": "catalog:",
    "@tanstack/expo-db-sqlite-persistence": "catalog:",
    "@tanstack/offline-transactions": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@toda/backend": "workspace:*",
    "convex": "catalog:",
    "expo": "catalog:",
    "expo-application": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-file-system": "catalog:",
    "expo-haptics": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-notifications": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
