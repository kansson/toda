<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/toda_widget_preview_new"
  android:gravity="center"
  android:orientation="horizontal">

  <ImageView
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_marginEnd="8dp"
    android:src="@drawable/toda_widget_add"
    android:tint="@color/glance_colorOnPrimaryContainer" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/toda_widget_new_task"
    android:textColor="@color/glance_colorOnPrimaryContainer"
    android:textSize="16sp" />
</LinearLayout>
