<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the real layout's shape, in the widget's own dynamic colour roles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/toda_widget_preview_bg"
  android:orientation="vertical"
  android:paddingHorizontal="8dp"
  android:paddingBottom="8dp">

  <!-- As the widget's title row: the + as far from the top as from the side, the title bold and
       centred on it. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/toda_widget_preview_list"
      android:textColor="@color/glance_colorOnSurface"
      android:textSize="16sp"
      android:textStyle="bold" />

    <ImageView
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="@drawable/toda_widget_preview_add"
      android:padding="12dp"
      android:src="@drawable/toda_widget_add"
      android:tint="@color/glance_colorOnSecondaryContainer" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_marginEnd="22dp"
      android:src="@drawable/toda_widget_preview_box" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/toda_widget_preview_task_one"
        android:textColor="@color/glance_colorOnSurface"
        android:textSize="15sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toda_widget_preview_due_one"
        android:textColor="@color/glance_colorError"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_marginEnd="22dp"
      android:src="@drawable/toda_widget_preview_box" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/toda_widget_preview_task_two"
        android:textColor="@color/glance_colorOnSurface"
        android:textSize="15sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toda_widget_preview_due_two"
        android:textColor="@color/glance_colorOnSurfaceVariant"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
